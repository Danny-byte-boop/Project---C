  m_Script: {fileID: 11500000, guid: a2d4959423f90684a99f95de2801e5f5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TrialManager
  timeLimit: 10
  targetScore: 1
  timerText: {fileID: 169132391}
  scoreText: {fileID: 1870986197}
  resultText: {fileID: 262020690}
  introLines:
  - speaker: Chuck
    text: IF YOU CAN HEAR ME BARBARA, We NEED TO GATHER COCONUTS RIGHT NOW.
  - speaker: BARBARA
    text: CHUCK, I CAN'T HEAR YOU.
  - speaker: Chuck
    text: UGH, FINE I'll DO IT MYSELF
  - speaker: Barbara
    text: UGH, WHATEVER. OH COCONUTS.
  platformerLines:
  - speaker: Chuck
    text: Oh Barbara, we found each other :)
  - speaker: BARBARA
    text: Oh how I've missed you my little Chuck.
  - speaker: Chuck
    text: Why are we so far up? What happened to the island.
  - speaker: BARBARA
    text: I don't know, but it seems like we are standing on a platform.
  - speaker: Chuck
    text: You know I can't get to that platform because of my short legs. I can't
      jump very well.
  - speaker: BARBARA
    text: It's okay, with the power of friendship and my helping mechanic I can push
      you to the other platform, and don't worry about me; I've always been able
      to jump higher than you.
  - speaker: Chuck
    text: Oh Barbara, you're the best! Let's get off of this island together!
